{
    "name": "Snakedye Chocolate",
    "type": "dark",
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "enumMember": { "foreground": "#829e9b" },
        "property": { "foreground": "#d9b27c" },
        "parameter": { "foreground": "#ab9382" },
        "function": { "foreground": "#d9b27c" }
    },
    "colors": {
